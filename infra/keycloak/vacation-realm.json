{
  "realm": "vacation",
  "enabled": true,
  "displayName": "Vacation Approval",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "roles": {
    "realm": [
      {"name": "employee", "description": "Submit and view own leave requests"},
      {"name": "manager", "description": "View pending manager approvals"}
    ]
  },
  "clients": [
    {
      "clientId": "vacation-api",
      "name": "Vacation API audience",
      "enabled": true,
      "protocol": "openid-connect",
      "bearerOnly": true,
      "publicClient": false,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": false
    },
    {
      "clientId": "vacation-web",
      "name": "Vacation browser application",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "redirectUris": ["http://localhost:5173/*", "http://127.0.0.1:5173/*"],
      "webOrigins": ["http://localhost:5173", "http://127.0.0.1:5173"],
      "attributes": {"pkce.code.challenge.method": "S256"},
      "defaultClientScopes": ["basic", "roles", "profile", "email", "web-origins"],
      "protocolMappers": [
        {
          "name": "vacation-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "vacation-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "id": "11111111-1111-4111-8111-111111111111",
      "username": "employee",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Employee",
      "realmRoles": ["employee"],
      "credentials": [{"type": "password", "value": "employee123", "temporary": false}]
    },
    {
      "id": "22222222-2222-4222-8222-222222222222",
      "username": "manager",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Demo",
      "lastName": "Manager",
      "realmRoles": ["manager"],
      "credentials": [{"type": "password", "value": "manager123", "temporary": false}]
    }
  ]
}
